APP_NAME=hyper-starter
DATABASE_URL=sqlite+aiosqlite:///./hyper.db
RATE_LIMIT_PER_MINUTE=60
SANDBOX_IDLE_TIMEOUT_SECONDS=1800
ADMIN_API_KEY=change-me
ENGINE_BACKEND=fake
GRPC_TARGET=localhost:50051
GRPC_TIMEOUT_SECONDS=30
GRPC_IMAGE_TIMEOUT_SECONDS=600
GRPC_EXEC_TIMEOUT_MS=60000
GRPC_ARCH=x86_64
GRPC_USE_TLS=false
